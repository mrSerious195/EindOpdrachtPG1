@startuml
skinparam linetype ortho
class Stad{
Naam : string
Id : Int?
}

class Straad{
    Naam : string
Id : Int?
}

Straad x-- "1\n+Stad" Stad
class Adress{
HuisNummer : string
}

Adress x-- "1\n+Straad" Straad
class NaamInfo{
Id : Int?
Naam : string

}

Enum GramatikaalGeslacht{
    Mannelijk
    Vrouwlijk
    Onzijdig
}

Enum NaamSoort{
    VoorNaam
    AchterNaam
}

Class DataSet{
DataSetID : Int?
}

DataSet x-- "1..*\n+Straten" Straad
DataSet x-- "1..*\n+Namen" NaamInfo

class Klant{
    Id : Int?
    VoorNaam : string
    AchterNaam : string
    Geslacht : Geslacht
    Leeftijd : DateTime
}
Enum Geslacht{
    Man
    Vrouw
}

Klant x-- "1\n+Adress" Adress

class Simulatie{
    + AddKlant(klant : Klant):void
    + RemoveKlant (klant : Klant): void
}

Simulatie x--"1..*+Klanten" Klant

class DataSetManager{
 + GetDataSet(land : string): DataSet
 + AddDataSet(dataSet : DataSet): DataSet
}

interface IDataSetRepo{
+ GetDataSet(land : string): DataSet
 + SetDataSet(land : string): DataSet
}

DataSetManager x--"1\n+DataSetRepo"IDataSetRepo

DataSetManager x--"0..*\n+DataSets"DataSet


class SimulatieManager{
VoegSimulatieToe(simulatie : Simulatie) : void
VoegSimulatieToe(simulatie : Simulatie) : void
}

interface ISimulatieRepo{
    + VoegSimulatieToe(simulatie Simulatie) : void
    + GeefInfoVanAllSavedSimulaties() : SimulatieInfoShortDTO[]
    + GeefSimulatie(Id : int?): Simulatie
    + GeefSimulatieInfoVanLand(land : string): SimulatieInfoShortDTO[]
    + GeefSimulatieInfoVanLeverancier(Leverancier : string): SimulatieInfoShortDTO[]
}

Folder DTO{
 class SimulatieInfoShortDTO{

 }
 class DatasetInfoShortDTO{

 }
 class DatasetDTO{

 }

 class SimulatieDTO{

 }

 class SimulatieConfigDTO{

 }
}

SimulatieManager x--"1\n+DataSetRepo"ISimulatieRepo

SimulatieManager x--"0..*\n+DataSets"Simulatie

interface ISimulatieSchrijver{
 + schrijfSimulatie(simulatie : Simulatie) : void
}

interface IDataSetLezer{
 + LeesDataSet() : Dataset

}

class LandenManager{

}
Interface ILandenRepo{

}
class BedrijfManager{

}
Interface IBedrijvenRepo{

}
LandenManager x-- "1\n-_landenRepo" ILandenRepo
BedrijfManager x-- "1\n-_bedrijvenRepo" IBedrijvenRepo

folder domeinControlers{
class InitialisatieDC{
+InitialisatieDC(DataSetManager : DataSetManager,DataSetLezer : IDataSetLezer)
+ LeesDataSet():void
+ GeefInfoDataSet : DatasetDTO
+ AddDatasetToMemory : void
}
class SimulatieDC{
+ SimulatieDC(DataSetManager : DataSetManager,SimulatieManager : SimulatieManager)
+ GeefAlleLanden():string[]
+ geefAlleStedenVanLand(land string): string[]
+ GeefAllebedrijven():string[]
+ voegbedrijftoe(bedrijf : string)
+ MaakSimulatie(SimulatieConfigDTO):void
+ GeefInfoNieuweSimulatie() : SimulatieDTO
+ saveSimulatie() : void
}
}

LandenManager "1\n-_landenManager" --x  SimulatieDC
BedrijfManager "1\n-_bedrijfManager"  --x  SimulatieDC

IDataSetLezer "1\n-_simulatieSchrijver" --X domeinControlers.InitialisatieDC
DataSetManager "1\n-_dataSetManager" --X domeinControlers.InitialisatieDC

ISimulatieSchrijver --x SimulatieManager

SimulatieDC x-- "1\n-_simulatieManager" SimulatieManager
SimulatieDC x-- "1\n-_dataSetManager" DataSetManager

@enduml