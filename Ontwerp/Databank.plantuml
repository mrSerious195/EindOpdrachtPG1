@startuml databank
title database
' configuration
hide circle
skinparam linetype ortho



class NaamData{
dataSet_id: int<foreign key>
id : int <key>
naam : varchar(500)
frequency : int
gender: char
NaamType: varchar(5)
}

class DataSet{
    id: int
    tijd_aanmaak : DateTime
    land_id
}

class Land{
    id : int
    naam: varchar(500)
}
DataSet "land_id"--"id" Land

class Stad{
    dataSet_id: int
    id:int
    naam: varchar(500)
}

class Straat{
    stad_id: int
    id:int
    naam: varchar(500)
}

DataSet "id"-U-"dataSet_id" Stad
DataSet "id"-U-"dataSet_id" NaamData
class anchor{}
hide anchor
DataSet -- anchor
NaamData -- anchor
anchor -l- Stad
Straat "stad_id" -- "id" Stad

class Simulatie{
    id : int
    DataSet_id : int
    SimulatieTijd : DateTime 
    bedrijf_id: int
    Seed : int
    MinimumLeeftijd : int
    MaximumLeeftijd : int
}

DataSet "id"---"dataSet_id" Simulatie

class SimKlant{
Id: int
simulatie_id: int
 Voornaam : varchar(500)
 Achternaam : varchar(500)
 GeboorteDatum : Date
 Geslacht : char

}

Simulatie "id" -- "simulatie_id" SimKlant

class Bedrijf{
    id : int
    naam : varchar(500)
}

Bedrijf "id" -- "bedrijf_id" Simulatie

@enduml