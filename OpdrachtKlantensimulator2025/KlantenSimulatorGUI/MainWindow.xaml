<Window x:Class="KlantenSimulatorGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KlantenSimulatorGUI"
        mc:Ignorable="d"
        Title="Klanten Simulator" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="Generate new dataset"  Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"/>
        <Button Content="Search" Click="SearchSimulaties" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"/>
        <TextBox Name="Searchbox" TextWrapping="Wrap" Text="" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="0"/>
        
        <RadioButton GroupName="SearchOption"  Name="DatasetRadioButton" IsChecked="True" Content="Dataset" Grid.Column="2" Grid.Row="1"/>
        <RadioButton GroupName="SearchOption"  Name="LandRadioButton" Content="Land" Grid.Column="3" Grid.Row="1"/>
        <RadioButton GroupName="SearchOption"  Name="OpdrachtGeverRadioButton" Content="Opdrachtgever" Grid.Column="4" Grid.Row="1"/>
        <DataGrid x:Name="SimpleSimGrid" Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="2" AutoGenerateColumns="True" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        




    </Grid>
</Window>
