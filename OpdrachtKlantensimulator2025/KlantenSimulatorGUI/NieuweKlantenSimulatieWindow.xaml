<Window x:Class="KlantenSimulatorGUI.NieuweKlantenSimulatieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KlantenSimulatorGUI"
        mc:Ignorable="d"
        Title="NieuweKlantenSimulatieWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="OpdrachtGever" Grid.Row="0" Grid.Column="0"/>
        <ComboBox Name="OpdrachtgeverBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Button Content="+" Click="NieuweOpdrachtGever" Grid.Row="0" Grid.Column="3"/>
        <Label Content="Dataset" Grid.Row="1" Grid.Column="0"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Label Content="MinimumLeeftijd" Grid.Row="2" Grid.Column="0"/>
        <TextBox TextWrapping="Wrap" Text="TextBlock" Grid.Row="2" Grid.Column="1"/>
        <Label Content="MinimumLeeftijd" Grid.Row="2" Grid.Column="2"/>
        <TextBox TextWrapping="Wrap" Text="TextBlock" Grid.Row="2" Grid.Column="3"/>
        <Label Content="Kans op een letter in huisnummer" Grid.Row="3" Grid.Column="0"/>
        <Slider Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1"/>
        <Label Content="Maximum grote huisnummers" Grid.Row="3" Grid.Column="2"/>
        <TextBox TextWrapping="Wrap" Text="TextBlock" Grid.Row="3" Grid.Column="3"/>
        <Label Content="Aantal klanten" Grid.Row="4" Grid.Column="0"/>
        <TextBox TextWrapping="Wrap" Text="TextBlock" Grid.Row="4" Grid.Column="1"/>
        <Label Content="seed" Grid.Row="5" Grid.Column="0"/>
        <TextBox TextWrapping="Wrap" Text="TextBlock" Grid.Row="5" Grid.Column="1"/>
        <Label Content="Gelimiteerd tot Steden" Grid.Row="6" Grid.Column="0"/>
    </Grid>
</Window>
